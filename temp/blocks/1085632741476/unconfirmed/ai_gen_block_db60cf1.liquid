{% doc %}
  @prompt
    Create a custom blog posts layout for the blogs/news page with the following design:
    - First/featured post displayed large at the top: image on the left (60% width), title and excerpt text on the right (40% width), with a "Read more" link
    - Remaining posts displayed in a 3-column grid below the featured post
    - Each grid card has: consistent aspect ratio image on top, post title, short excerpt, and "Read more" link
    - Clean, minimal, editorial style with consistent card heights
    - Responsive: on mobile show single column for all posts
    - Match CHIC brand: clean white background, dark text, botanical premium feel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-news-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 32px 0;
    color: #1d1a22;
    background: #ffffff;
  }

  .ai-news-layout-{{ ai_gen_id }}__featured {
    display: grid;
    grid-template-columns: 3fr 2fr;
    background: #ffffff;
    margin-bottom: 48px;
    min-height: 320px;
  }

  .ai-news-layout-{{ ai_gen_id }}__featured-media,
  .ai-news-layout-{{ ai_gen_id }}__card-media {
    display: block;
    overflow: hidden;
    background: #e7f0d9;
  }

  .ai-news-layout-{{ ai_gen_id }}__featured-media {
    aspect-ratio: 3 / 2;
  }

  .ai-news-layout-{{ ai_gen_id }}__featured-media img,
  .ai-news-layout-{{ ai_gen_id }}__card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-news-layout-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    min-height: 220px;
  }

  .ai-news-layout-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
    color: #59705a;
  }

  .ai-news-layout-{{ ai_gen_id }}__featured-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(24px, 5vw, 64px);
  }

  .ai-news-layout-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 14px;
    color: #52684f;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-news-layout-{{ ai_gen_id }}__title {
    margin: 0 0 16px;
    color: #1d1a22;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.15;
  }

  .ai-news-layout-{{ ai_gen_id }}__excerpt {
    margin: 0;
    color: #39363d;
    font-size: 15px;
    line-height: 1.7;
  }

  .ai-news-layout-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: #1d1a22;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #52684f;
    padding-bottom: 4px;
  }

  .ai-news-layout-{{ ai_gen_id }}__link:hover {
    color: #52684f;
  }

  .ai-news-layout-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid #0d4a70;
    outline-offset: 4px;
  }

  .ai-news-layout-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .ai-news-layout-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ai-news-layout-{{ ai_gen_id }}__card-media {
    aspect-ratio: 4 / 3;
    margin-bottom: 18px;
  }

  .ai-news-layout-{{ ai_gen_id }}__card-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
  }

  .ai-news-layout-{{ ai_gen_id }}__card-title {
    margin: 0 0 10px;
    color: #1d1a22;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: 21px;
    font-weight: 400;
    line-height: 1.3;
  }

  .ai-news-layout-{{ ai_gen_id }}__card-excerpt {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: #39363d;
    font-size: 14px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .ai-news-layout-{{ ai_gen_id }}__card .ai-news-layout-{{ ai_gen_id }}__link {
    margin-top: auto;
    padding-top: 22px;
  }

  .ai-news-layout-{{ ai_gen_id }}__empty {
    padding: 36px;
    text-align: center;
    color: #39363d;
    background: #f5f7f2;
  }

  @media screen and (max-width: 749px) {
    .ai-news-layout-{{ ai_gen_id }} {
      padding: 20px 0;
    }

    .ai-news-layout-{{ ai_gen_id }}__featured {
      grid-template-columns: 1fr;
      margin-bottom: 36px;
    }

    .ai-news-layout-{{ ai_gen_id }}__featured-copy {
      padding: 24px 4px;
    }

    .ai-news-layout-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-news-layout-{{ ai_gen_id }}__card-media {
      aspect-ratio: 4 / 3;
    }
  }
{% endstyle %}

<div class="ai-news-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign news_blog = block.settings.blog %}
  {% if news_blog != blank and news_blog.articles.size > 0 %}
    {% assign featured_article = news_blog.articles.first %}
    <article class="ai-news-layout-{{ ai_gen_id }}__featured">
      <a class="ai-news-layout-{{ ai_gen_id }}__featured-media" href="{{ featured_article.url }}" aria-label="Read {{ featured_article.title | escape }}">
        {% if featured_article.image %}
          <img src="{{ featured_article.image | image_url: width: 1400 }}" alt="{{ featured_article.image.alt | default: featured_article.title | escape }}" width="{{ featured_article.image.width }}" height="{{ featured_article.image.height }}" loading="lazy">
        {% else %}
          <div class="ai-news-layout-{{ ai_gen_id }}__placeholder">{{ 'blog-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </a>
      <div class="ai-news-layout-{{ ai_gen_id }}__featured-copy">
        <p class="ai-news-layout-{{ ai_gen_id }}__eyebrow">{{ block.settings.featured_label | escape }}</p>
        <h2 class="ai-news-layout-{{ ai_gen_id }}__title">{{ featured_article.title | escape }}</h2>
        <p class="ai-news-layout-{{ ai_gen_id }}__excerpt">{{ featured_article.excerpt_or_content | strip_html | truncate: 220 | escape }}</p>
        <a class="ai-news-layout-{{ ai_gen_id }}__link" href="{{ featured_article.url }}">{{ block.settings.read_more_label | escape }}<span aria-hidden="true">→</span></a>
      </div>
    </article>

    {% if news_blog.articles.size > 1 %}
      <div class="ai-news-layout-{{ ai_gen_id }}__grid">
        {% for article in news_blog.articles offset: 1 limit: block.settings.posts_to_show %}
          <article class="ai-news-layout-{{ ai_gen_id }}__card">
            <a class="ai-news-layout-{{ ai_gen_id }}__card-media" href="{{ article.url }}" aria-label="Read {{ article.title | escape }}">
              {% if article.image %}
                <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}" loading="lazy">
              {% else %}
                <div class="ai-news-layout-{{ ai_gen_id }}__placeholder">{{ 'blog-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <div class="ai-news-layout-{{ ai_gen_id }}__card-copy">
              <h3 class="ai-news-layout-{{ ai_gen_id }}__card-title">{{ article.title | escape }}</h3>
              <p class="ai-news-layout-{{ ai_gen_id }}__card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 150 | escape }}</p>
              <a class="ai-news-layout-{{ ai_gen_id }}__link" href="{{ article.url }}">{{ block.settings.read_more_label | escape }}<span aria-hidden="true">→</span></a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-news-layout-{{ ai_gen_id }}__empty">Choose a blog in the block settings to display its published posts.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Editorial blog layout",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Grid posts to show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 9
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Featured label",
      "default": "Featured story"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more"
    }
  ],
  "presets": [
    {
      "name": "Editorial blog layout"
    }
  ],
  "tag": null,
  "class": "editorial-blog-layout"
}
{% endschema %}