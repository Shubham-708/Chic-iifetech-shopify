        { "type": "text", "id": "title", "label": "Title", "default": "Natural Ingredients" },
        { "type": "text", "id": "text", "label": "Text", "default": "Made with care" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chic promo banners",
      "category": "Banners",
      "blocks": [
        { "type": "promo", "settings": { "style": "light", "tag": "Flat 25% Discount", "heading": "Special Hair Care", "heading_accent": "Deals", "text": "Nourish, strengthen & shine with our expert hair care range.", "btn_label": "Shop Now", "fallback_asset": "chic-promo-hair.png" } },
