        { "type": "trust", "settings": { "icon": "leaf", "title": "Natural Ingredients", "text": "Made with care" } },
        { "type": "trust", "settings": { "icon": "shield", "title": "Dermatologist Tested", "text": "Safe for all skin types" } },
        { "type": "trust", "settings": { "icon": "rabbit", "title": "Cruelty Free", "text": "Not tested on animals" } },
        { "type": "trust", "settings": { "icon": "users", "title": "Customer Support", "text": "We're here for you" } }
      ]
    }
  ]
}
{% endschema %}
