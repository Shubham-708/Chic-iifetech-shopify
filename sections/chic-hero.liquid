{% liquid
  assign s = section.settings
  assign slides = section.blocks | where: 'type', 'slide'

  # Fallback single image when no slides are added
  if s.image != blank
    assign fallback_image_url = s.image | image_url: width: 1600
  else
    assign fallback_image_url = 'chic-hero.jpg' | asset_url
  endif
%}

<div
  class="chic-hero"
  id="chic-hero-{{ section.id }}"
  data-chic-slider
  data-slide-duration="{{ s.slide_duration | default: 4 | times: 1000 }}"
  style="--chic-hero-focal: {{ s.focal_x | default: 72 }}%;"
>
  <div class="chic-hero__wrap chic-wrap">
    <div class="chic-hero__text">
      {% if s.eyebrow != blank %}
        <p class="chic-eyebrow">{{ s.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="chic-hero__heading">
        {{ s.heading | escape }}
        {% if s.heading_accent != blank %}
          <em>{{ s.heading_accent | escape }}</em>
        {% endif %}
      </h1>
      {% if s.text != blank %}
        <p class="chic-hero__lead">{{ s.text }}</p>
      {% endif %}
      <div class="chic-hero__btns">
        {% if s.btn1_label != blank %}
          <a class="chic-btn chic-btn--solid" href="{% render 'chic-link', url: s.btn1_link %}">{{ s.btn1_label | escape }}</a>
        {% endif %}
        {% if s.btn2_label != blank %}
          <a class="chic-btn chic-btn--ghost" href="{% render 'chic-link', url: s.btn2_link %}">{{ s.btn2_label | escape }}</a>
        {% endif %}
      </div>

      {% if slides.size > 1 %}
        <div class="chic-hero__dots" data-chic-dots role="tablist" aria-label="Hero slides">
          {% for slide in slides %}
            <button
              type="button"
              class="{% if forloop.first %}on{% endif %}"
              data-chic-dot="{{ forloop.index0 }}"
              aria-label="Slide {{ forloop.index }}"
            ></button>
          {% endfor %}
        </div>
      {% else %}
        <div class="chic-hero__dots" aria-hidden="true">
          <span class="on"></span><span></span><span></span>
        </div>
      {% endif %}
    </div>

    <div class="chic-hero__img" data-chic-slides>
      {% if slides.size > 0 %}
        {% for slide in slides %}
          {% liquid
            assign bs = slide.settings
            if bs.image != blank
              assign slide_img = bs.image | image_url: width: 1600
            elsif bs.fallback_asset != blank
              assign slide_img = bs.fallback_asset | asset_url
            else
              assign slide_img = 'chic-hero.jpg' | asset_url
            endif
          %}
          <div
            class="chic-hero__slide{% if forloop.first %} is-active{% endif %}"
            data-chic-slide
            {{ slide.shopify_attributes }}
          >
            {% if bs.video != blank %}
              {{ bs.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
            {% else %}
              <img
                src="{{ slide_img }}"
                alt="{{ s.heading | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
                width="1600"
                height="900"
              >
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <div class="chic-hero__slide is-active" data-chic-slide>
          <img
            src="{{ fallback_image_url }}"
            alt="{{ s.heading | escape }}"
            loading="eager"
            fetchpriority="high"
            width="1600"
            height="900"
          >
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .chic-hero {
    background: linear-gradient(100deg, var(--chic-mint-xl) 0%, var(--chic-mint) 100%);
    overflow: hidden;
  }

  .chic-hero .chic-hero__wrap {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 30px;
    min-height: 560px;
    max-width: none;
    margin: 0;
    padding-right: 0;
    padding-left: max(24px, calc((100vw - 1240px) / 2 + 24px));
  }

  .chic-hero__heading {
    font-family: var(--chic-serif);
    font-weight: 400;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.12;
    margin: 0 0 20px;
    color: var(--chic-ink);
  }

  .chic-hero__heading em {
    font-style: normal;
    color: var(--chic-green);
    display: block;
  }

  .chic-hero__lead {
    color: var(--chic-muted);
    max-width: 440px;
    margin: 0 0 30px;
    font-size: 15px;
    line-height: 1.7;
  }

  .chic-hero__btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .chic-hero__dots {
    display: flex;
    gap: 10px;
    margin-top: 44px;
  }

  .chic-hero__dots span,
  .chic-hero__dots button {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--chic-navy);
    background: transparent;
    padding: 0;
    opacity: 0.6;
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .chic-hero__dots span.on,
  .chic-hero__dots button.on {
    background: var(--chic-green);
    border-color: var(--chic-green);
    width: 24px;
    border-radius: 5px;
    opacity: 1;
  }

  .chic-hero__img {
    position: relative;
    align-self: stretch;
    min-height: 560px;
  }

  .chic-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }

  .chic-hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .chic-hero__slide img,
  .chic-hero__slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--chic-hero-focal, 72%) 22%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 18%);
    mask-image: linear-gradient(90deg, transparent 0, #000 18%);
  }

  @media screen and (max-width: 860px) {
    .chic-hero .chic-hero__wrap {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 40px 24px 0;
    }

    .chic-hero__img {
      margin: 0 -24px;
      min-height: 300px;
      max-height: 380px;
    }

    .chic-hero__slide img,
    .chic-hero__slide video {
      object-position: var(--chic-hero-focal, 72%) 15%;
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 20%);
      mask-image: linear-gradient(180deg, transparent 0, #000 20%);
    }

    .chic-hero__dots { margin-top: 28px; }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-chic-slider]').forEach((root) => {
    if (root.dataset.chicInit) return;
    root.dataset.chicInit = '1';

    const slides = Array.from(root.querySelectorAll('[data-chic-slide]'));
    if (slides.length < 2) {
      const v = root.querySelector('video');
      if (v) v.play().catch(() => {});
      return;
    }

    const dots = Array.from(root.querySelectorAll('[data-chic-dot]'));
    const duration = Number(root.dataset.slideDuration) || 4000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer;

    const show = (i) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((slide, n) => {
        const active = n === current;
        slide.classList.toggle('is-active', active);
        const video = slide.querySelector('video');
        if (video) {
          if (active) {
            video.currentTime = 0;
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      });
      dots.forEach((d, n) => d.classList.toggle('on', n === current));
    };

    const start = () => {
      if (reduceMotion) return;
      clearInterval(timer);
      timer = setInterval(() => show(current + 1), duration);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(Number(dot.dataset.chicDot));
        start();
      });
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearInterval(timer);
      else start();
    });

    show(0);
    start();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Chic hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add 'Slide' blocks for a video/image slider on the right. With no slides, the single image below is used."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (no slides)",
      "info": "Leave empty to use the bundled brand image"
    },
    {
      "type": "range",
      "id": "focal_x",
      "label": "Media focus (left–right)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 72
    },
    {
      "type": "range",
      "id": "slide_duration",
      "label": "Seconds per slide",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Botanical Skin Rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading line 1",
      "default": "Glow Naturally."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading line 2 (green)",
      "default": "Shine Confidently."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pure Ayurvedic and plant-based beauty for face, body and hair — made with neem, aloe vera, kokum and jojoba for every skin type."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary button label",
      "default": "Explore Skincare"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (3–5 sec, autoplays muted)",
          "info": "If set, the video is shown instead of the image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback asset filename"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Chic hero",
      "category": "Banners",
      "blocks": [
        { "type": "slide", "settings": { "fallback_asset": "chic-hero.jpg" } }
      ]
    }
  ]
}
{% endschema %}
