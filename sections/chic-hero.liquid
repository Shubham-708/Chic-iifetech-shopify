{% liquid
  assign s = section.settings
  if s.image != blank
    assign image_url = s.image | image_url: width: 1600
  else
    assign image_url = 'chic-hero.jpg' | asset_url
  endif
%}

<div class="chic-hero">
  <div class="chic-hero__wrap chic-wrap">
    <div class="chic-hero__text">
      {% if s.eyebrow != blank %}
        <p class="chic-eyebrow">{{ s.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="chic-hero__heading">
        {{ s.heading | escape }}
        {% if s.heading_accent != blank %}
          <em>{{ s.heading_accent | escape }}</em>
        {% endif %}
      </h1>
      {% if s.text != blank %}
        <p class="chic-hero__lead">{{ s.text }}</p>
      {% endif %}
      <div class="chic-hero__btns">
        {% if s.btn1_label != blank %}
          <a class="chic-btn chic-btn--solid" href="{{ s.btn1_link | default: routes.all_products_collection_url }}">{{ s.btn1_label | escape }}</a>
        {% endif %}
        {% if s.btn2_label != blank %}
          <a class="chic-btn chic-btn--ghost" href="{{ s.btn2_link | default: routes.all_products_collection_url }}">{{ s.btn2_label | escape }}</a>
        {% endif %}
      </div>
      <div class="chic-hero__dots" aria-hidden="true">
        <span class="on"></span><span></span><span></span>
      </div>
    </div>
    <div class="chic-hero__img">
      <img
        src="{{ image_url }}"
        alt="{{ s.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="900"
      >
    </div>
  </div>
</div>

{% stylesheet %}
  .chic-hero {
    background: linear-gradient(100deg, var(--chic-mint-xl) 0%, var(--chic-mint) 100%);
    overflow: hidden;
  }

  .chic-hero__wrap {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 30px;
    min-height: 540px;
    padding-right: 0;
  }

  .chic-hero__heading {
    font-family: var(--chic-serif);
    font-weight: 400;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.12;
    margin: 0 0 20px;
    color: var(--chic-ink);
  }

  .chic-hero__heading em {
    font-style: normal;
    color: var(--chic-green);
    display: block;
  }

  .chic-hero__lead {
    color: var(--chic-muted);
    max-width: 440px;
    margin: 0 0 30px;
    font-size: 15px;
    line-height: 1.7;
  }

  .chic-hero__btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .chic-hero__dots {
    display: flex;
    gap: 10px;
    margin-top: 44px;
  }

  .chic-hero__dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--chic-navy);
    opacity: 0.6;
  }

  .chic-hero__dots span.on {
    background: var(--chic-green);
    border-color: var(--chic-green);
    width: 24px;
    border-radius: 5px;
    opacity: 1;
  }

  .chic-hero__img {
    align-self: stretch;
    position: relative;
  }

  .chic-hero__img img {
    width: 100%;
    height: 100%;
    min-height: 540px;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 18%);
    mask-image: linear-gradient(90deg, transparent 0, #000 18%);
  }

  @media screen and (max-width: 860px) {
    .chic-hero__wrap {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 40px 24px 0;
    }

    .chic-hero__img {
      margin: 0 -24px;
    }

    .chic-hero__img img {
      min-height: 280px;
      max-height: 360px;
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 20%);
      mask-image: linear-gradient(180deg, transparent 0, #000 20%);
    }

    .chic-hero__dots { margin-top: 28px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the bundled brand image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Botanical Skin Rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading line 1",
      "default": "Glow Naturally."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading line 2 (green)",
      "default": "Shine Confidently."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pure Ayurvedic and plant-based beauty for face, body and hair — made with neem, aloe vera, kokum and jojoba for every skin type."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary button label",
      "default": "Explore Skincare"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Chic hero",
      "category": "Banners"
    }
  ]
}
{% endschema %}
