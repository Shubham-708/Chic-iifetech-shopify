{% liquid
  assign s = section.settings

  # Only render on products that match one of the keywords (handle, title or tags)
  assign show = true
  if s.match_keywords != blank and product != blank
    assign show = false
    assign tag_text = product.tags | join: ' '
    assign hay = product.handle | append: ' ' | append: product.title | append: ' ' | append: tag_text | downcase
    assign keys = s.match_keywords | downcase | split: ','
    for k in keys
      assign key = k | strip
      if key != blank and hay contains key
        assign show = true
        break
      endif
    endfor
  endif
%}

{% if show %}
  <div class="chic-ki" id="chic-ki-{{ section.id }}" data-chic-ki>
    <div class="chic-ki__inner">
      <header class="chic-ki__head">
        {% if s.eyebrow != blank %}<p class="chic-ki__eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
        {% if s.heading != blank %}<h2 class="chic-ki__heading">{{ s.heading | escape }}</h2>{% endif %}
        {% if s.intro != blank %}<div class="chic-ki__intro">{{ s.intro }}</div>{% endif %}
      </header>

      <div class="chic-ki__rail">
        <button type="button" class="chic-ki__arrow chic-ki__arrow--prev" data-chic-ki-prev aria-label="Previous ingredients">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <ul class="chic-ki__track" data-chic-ki-track role="list">
          {% for block in section.blocks %}
            {% assign b = block.settings %}
            <li class="chic-ki__card" {{ block.shopify_attributes }}>
              <div class="chic-ki__pic">
                {% if b.image != blank %}
                  {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 400, 600, 800', sizes: '(min-width: 990px) 220px, 45vw', alt: b.name, class: 'chic-ki__img' }}
                {% elsif b.asset != blank %}
                  <img
                    class="chic-ki__img"
                    src="{{ b.asset | asset_img_url: '400x' }}"
                    srcset="{{ b.asset | asset_img_url: '240x' }} 240w, {{ b.asset | asset_img_url: '400x' }} 400w, {{ b.asset | asset_url }} 800w"
                    sizes="(min-width: 990px) 220px, 45vw"
                    alt="{{ b.name | escape }}"
                    width="800"
                    height="800"
                    loading="lazy"
                  >
                {% endif %}
                {% if b.amount != blank %}<span class="chic-ki__amount">{{ b.amount | escape }}</span>{% endif %}
              </div>
              <p class="chic-ki__name">{{ b.name | escape }}</p>
              {% if b.benefit != blank %}<p class="chic-ki__benefit">{{ b.benefit | escape }}</p>{% endif %}
            </li>
          {% endfor %}
        </ul>
        <button type="button" class="chic-ki__arrow chic-ki__arrow--next" data-chic-ki-next aria-label="Next ingredients">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>

      {% if s.show_full_list and section.blocks.size > 0 %}
        <div class="chic-ki__list">
          <p class="chic-ki__list-title">{{ s.list_title | escape }}</p>
          <p class="chic-ki__list-items">
            {%- for block in section.blocks -%}
              <span>{{ block.settings.name | escape }}{% if block.settings.amount != blank %} {{ block.settings.amount | escape }}{% endif %}</span>
            {%- endfor -%}
          </p>
          {% if s.list_note != blank %}<p class="chic-ki__note">{{ s.list_note | escape }}</p>{% endif %}
          {% liquid
            assign has_credits = false
            for block in section.blocks
              if block.settings.credit != blank
                assign has_credits = true
                break
              endif
            endfor
          %}
          {% if has_credits %}
            <details class="chic-ki__credits">
              <summary>Photo credits</summary>
              <p>
                {%- for block in section.blocks -%}
                  {%- if block.settings.credit != blank -%}
                    {%- if block.settings.credit_url != blank -%}
                      <a href="{{ block.settings.credit_url }}" target="_blank" rel="noopener nofollow">{{ block.settings.credit | escape }}</a>
                    {%- else -%}
                      <span>{{ block.settings.credit | escape }}</span>
                    {%- endif -%}
                    {%- unless forloop.last %} · {% endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              </p>
            </details>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .chic-ki {
    background: #fff;
    color: var(--chic-ink, #1d1a22);
    font-family: var(--chic-sans);
  }

  .chic-ki__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) clamp(16px, 4vw, 40px);
  }

  .chic-ki__head {
    max-width: 760px;
    margin: 0 auto clamp(28px, 4vw, 44px);
    text-align: center;
  }

  .chic-ki__eyebrow {
    margin: 0 0 10px;
    color: var(--chic-green, #4f8455);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .chic-ki__heading {
    margin: 0 0 16px;
    font-family: var(--chic-sans);
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .chic-ki__intro {
    font-size: 15px;
    line-height: 1.75;
    color: inherit;
    opacity: 0.82;
  }

  .chic-ki__intro p { margin: 0 0 10px; }

  .chic-ki__rail {
    position: relative;
  }

  .chic-ki__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4 * 18px) / 5);
    gap: 18px;
    margin: 0;
    padding: 4px 2px 14px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .chic-ki__track::-webkit-scrollbar { display: none; }

  .chic-ki__card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 14px 18px;
    border: 1px solid #eceee8;
    border-radius: 18px;
    background: #fff;
    text-align: center;
    box-shadow: 0 1px 2px rgba(29, 26, 34, 0.04);
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .chic-ki__card:hover {
    transform: translateY(-4px);
    border-color: #dfe8d6;
    box-shadow: 0 14px 30px rgba(45, 90, 54, 0.12);
  }

  .chic-ki__pic {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 8px;
    border-radius: 14px;
    overflow: hidden;
    background: #f4f6f1;
  }

  .chic-ki__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .chic-ki__card:hover .chic-ki__img { transform: scale(1.06); }

  .chic-ki__amount {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--chic-green-d, #2d5a36);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .chic-ki__name {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: inherit;
  }

  .chic-ki__benefit {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: inherit;
    opacity: 0.72;
  }

  .chic-ki__arrow {
    position: absolute;
    top: 38%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid #e5e9e0;
    border-radius: 50%;
    background: #fff;
    color: inherit;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .chic-ki__arrow[disabled] { opacity: 0; pointer-events: none; }
  .chic-ki__arrow--prev { left: -14px; }
  .chic-ki__arrow--next { right: -14px; }

  .chic-ki__arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chic-ki__list {
    max-width: 920px;
    margin: clamp(28px, 4vw, 44px) auto 0;
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--chic-mint-xl, #f5f9ee);
    text-align: center;
  }

  .chic-ki__list-title {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--chic-green-d, #2d5a36);
  }

  .chic-ki__list-items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 8px;
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
  }

  .chic-ki__list-items span {
    padding: 4px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #e3ead8;
  }

  .chic-ki__note {
    margin: 12px 0 0;
    font-size: 12px;
    opacity: 0.65;
  }

  .chic-ki__credits {
    margin-top: 12px;
    font-size: 11px;
    opacity: 0.6;
  }

  .chic-ki__credits summary { cursor: pointer; }
  .chic-ki__credits p { margin: 6px 0 0; line-height: 1.6; }
  .chic-ki__credits a { color: inherit; }

  @media screen and (max-width: 989px) {
    .chic-ki__track { grid-auto-columns: calc((100% - 2 * 14px) / 3.2); gap: 14px; }
  }

  @media screen and (max-width: 749px) {
    .chic-ki__track {
      grid-auto-columns: 44%;
      gap: 12px;
      margin: 0 calc(-1 * clamp(16px, 4vw, 40px));
      padding-inline: clamp(16px, 4vw, 40px);
      scroll-padding-inline: clamp(16px, 4vw, 40px);
    }

    .chic-ki__arrow { display: none; }
    .chic-ki__card { padding: 10px 10px 14px; }
    .chic-ki__name { font-size: 14px; }
    .chic-ki__benefit { font-size: 12px; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const init = (root) => {
      if (root.dataset.chicInit) return;
      root.dataset.chicInit = '1';
      const track = root.querySelector('[data-chic-ki-track]');
      const prev = root.querySelector('[data-chic-ki-prev]');
      const next = root.querySelector('[data-chic-ki-next]');
      if (!track) return;
      const step = () => track.clientWidth * 0.8;
      const update = () => {
        const max = track.scrollWidth - track.clientWidth - 2;
        if (prev) prev.disabled = track.scrollLeft <= 2;
        if (next) next.disabled = track.scrollLeft >= max;
      };
      prev?.addEventListener('click', () => track.scrollBy({ left: -step() }));
      next?.addEventListener('click', () => track.scrollBy({ left: step() }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    };
    const boot = () => document.querySelectorAll('[data-chic-ki]').forEach(init);
    boot();
    document.addEventListener('shopify:section:load', boot);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Chic key ingredients",
  "tag": "section",
  "class": "chic-ki-section",
  "settings": [
    {
      "type": "text",
      "id": "match_keywords",
      "label": "Show only on products matching",
      "info": "Comma-separated words matched against the product handle, title and tags. Leave empty to show on every product.",
      "default": "hair-oil, hair oil, hair-amrut, hair amrut"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Infused with 18 herbs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Backed by the Right Ingredients" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "checkbox", "id": "show_full_list", "label": "Show full ingredient list", "default": true },
    { "type": "text", "id": "list_title", "label": "Full list title", "default": "Full ingredient list" },
    { "type": "text", "id": "list_note", "label": "Full list note" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Bundled image filename" },
        { "type": "text", "id": "name", "label": "Name", "default": "Bhringraj" },
        { "type": "text", "id": "amount", "label": "Amount", "info": "e.g. 1.5%" },
        { "type": "text", "id": "benefit", "label": "Benefit" },
        { "type": "text", "id": "credit", "label": "Photo credit" },
        { "type": "url", "id": "credit_url", "label": "Photo credit link" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    { "name": "Chic key ingredients", "category": "Product" }
  ]
}
{% endschema %}
