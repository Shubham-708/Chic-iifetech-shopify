{% liquid
  assign s = section.settings
%}

<div class="chic-section chic-reviews-outer">
  <div class="chic-wrap">
    <div class="chic-reviews">
      <div class="chic-sec-head">
        <div>
          {% if s.eyebrow != blank %}<p class="chic-eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
          <h2>{{ s.heading | escape }}</h2>
        </div>
        <div class="chic-carousel-arrows">
          <button class="chic-arrow chic-arrow--prev" aria-label="Previous">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="chic-arrow chic-arrow--next" aria-label="Next">
            <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
          </button>
        </div>
      </div>

      <div class="chic-rgrid-wrapper">
        <div class="chic-rgrid">
          {% for block in section.blocks %}
            <div class="chic-rcard" {{ block.shopify_attributes }}>
              <div class="chic-stars chic-rcard__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <p class="chic-rcard__text">{{ block.settings.quote | escape }}</p>
              <div class="chic-rcard__who">
                <span class="chic-rcard__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
                <div>
                  <b>{{ block.settings.name | escape }}</b>
                  <small>{% render 'chic-icon', icon: 'check' %} Verified Buyer</small>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    const grid = document.querySelector('.chic-rgrid');
    const prevBtn = document.querySelector('.chic-arrow--prev');
    const nextBtn = document.querySelector('.chic-arrow--next');
    if (!grid || !prevBtn || !nextBtn) return;

    const scrollAmount = () => {
      const card = grid.querySelector('.chic-rcard');
      return card ? card.offsetWidth + 20 : 320;
    };

    prevBtn.addEventListener('click', () => {
      grid.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      grid.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  })();
</script>

{% stylesheet %}
  .chic-reviews {
    background: var(--chic-mint-xl);
    border: 1px solid var(--chic-line);
    border-radius: 22px;
    padding: clamp(28px, 4vw, 48px);
  }

  /* Arrow buttons */
  .chic-carousel-arrows {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .chic-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--chic-line);
    background: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    flex: none;
  }

  .chic-arrow:hover {
    background: var(--chic-navy);
    border-color: var(--chic-navy);
  }

  .chic-arrow svg {
    width: 18px;
    height: 18px;
    stroke: var(--chic-navy);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.2s ease;
  }

  .chic-arrow:hover svg {
    stroke: #fff;
  }

  /* Grid wrapper */
  .chic-rgrid-wrapper {
    overflow: hidden;
  }

  .chic-rgrid {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .chic-rgrid::-webkit-scrollbar { display: none; }

  .chic-rcard {
    background: var(--chic-card);
    border: 1px solid var(--chic-line);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s ease;
    flex: 0 0 calc(33.33% - 14px);
    scroll-snap-align: start;
    min-width: 280px;
  }

  .chic-rcard:hover { border-color: #c9d8b8; }

  .chic-rcard__stars {
    font-size: 14px;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .chic-rcard__text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--chic-ink);
    margin: 0 0 20px;
    flex: 1;
  }

  .chic-rcard__who {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--chic-line);
    padding-top: 16px;
  }

  .chic-rcard__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--chic-mint);
    color: var(--chic-green-d);
    display: grid;
    place-items: center;
    font-family: var(--chic-serif);
    font-size: 18px;
    flex: none;
  }

  .chic-rcard__who b {
    display: block;
    font-size: 14px;
    color: var(--chic-ink);
  }

  .chic-rcard__who small {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--chic-muted);
  }

  .chic-rcard__who small svg {
    width: 13px;
    height: 13px;
    stroke: var(--chic-green);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 860px) {
    .chic-rcard {
      flex: 0 0 84%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Botanical Circle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Natural, luxurious, and deeply hydrating. The Body Yogurt has become part of my everyday routine."
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Verena Yadav" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Chic testimonials",
      "category": "Storytelling",
      "blocks": [
        { "type": "review", "settings": { "quote": "Natural, luxurious, and deeply hydrating. The Body Yogurt has become part of my everyday routine.", "name": "Verena Yadav" } },
