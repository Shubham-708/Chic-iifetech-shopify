{% liquid
  assign s = section.settings
  assign col = s.collection

  # Fallbacks: 'all' collection, then the first collection that has products
  if col == blank or col.products.size == 0
    assign col = collections['all']
  endif
  if col == blank or col.products.size == 0
    for c in collections
      if c.products.size > 0
        assign col = c
        break
      endif
    endfor
  endif
%}

<div class="chic-section chic-products" id="chic-products-{{ section.id }}">
  <div class="chic-wrap">
    <div class="chic-sec-head">
      <div>
        {% if s.eyebrow != blank %}<p class="chic-eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
        <h2>{{ s.heading | escape }}</h2>
      </div>
      {% if s.link_label != blank %}
        <a class="chic-more" href="{% render 'chic-link', url: s.link %}">{{ s.link_label | escape }}</a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="chic-tabs" role="tablist">
        <button type="button" class="on" data-chic-tab="">All</button>
        {% for block in section.blocks %}
          <button type="button" data-chic-tab="{{ block.settings.match | downcase | escape }}" {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="chic-grid">
      {% for product in col.products limit: s.max_products %}
        {% render 'chic-product-card', product: product %}
      {% else %}
        {% for i in (1..8) %}
          <div class="chic-prod">
            <div class="chic-prod__pic">{{ 'product-' | append: forloop.index | placeholder_svg_tag: 'chic-prod__placeholder' }}</div>
            <div class="chic-prod__info">
              <h4>Sample Product</h4>
              <div class="chic-stars">&#9733;&#9733;&#9733;&#9733;&#9733;<small>(12)</small></div>
              <div class="chic-prod__row"><span class="chic-prod__price">Rs. 299.00</span></div>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <div class="chic-toast" data-chic-toast aria-live="polite"></div>
</div>

{% stylesheet %}
  .chic-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .chic-tabs button {
    border: 1px solid var(--chic-line);
    background: var(--chic-card);
    color: var(--chic-ink);
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 13px;
    font-family: var(--chic-sans);
    cursor: pointer;
  }

  .chic-tabs button.on {
    background: var(--chic-navy);
    border-color: var(--chic-navy);
    color: #fff;
  }

  .chic-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }

  @media screen and (max-width: 1100px) {
    .chic-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media screen and (max-width: 560px) {
    .chic-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.chic-products').forEach((root) => {
    if (root.dataset.chicInit) return;
    root.dataset.chicInit = '1';

    const toast = root.querySelector('[data-chic-toast]');
    let toastTimer;
    const showToast = (msg) => {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2400);
    };

    // tabs filter
    root.querySelectorAll('[data-chic-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('[data-chic-tab]').forEach((b) => b.classList.remove('on'));
        btn.classList.add('on');
        const term = btn.dataset.chicTab.toLowerCase();
        root.querySelectorAll('.chic-prod').forEach((card) => {
          const cats = (card.dataset.cats || '').toLowerCase();
          card.hidden = term !== '' && !cats.includes(term);
        });
      });
    });

    // wishlist (localStorage, per browser)
    let wished = [];
    try { wished = JSON.parse(localStorage.getItem('chic-wishlist') || '[]'); } catch (e) { wished = []; }
    root.querySelectorAll('[data-chic-wish]').forEach((btn) => {
      const id = btn.dataset.chicWish;
      if (wished.includes(id)) btn.classList.add('on');
      btn.addEventListener('click', (evt) => {
        evt.preventDefault();
        evt.stopPropagation();
        btn.classList.toggle('on');
        const i = wished.indexOf(id);
        if (i > -1) wished.splice(i, 1); else wished.push(id);
        try { localStorage.setItem('chic-wishlist', JSON.stringify(wished)); } catch (e) { /* private mode */ }
      });
    });

    // add to cart
    root.querySelectorAll('[data-chic-add]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          const res = await fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: Number(btn.dataset.chicAdd), quantity: 1 }),
          });
          if (!res.ok) throw new Error('add failed');
          const cartRes = await fetch((window.Shopify?.routes?.root || '/') + 'cart.js');
          const cart = await cartRes.json();
          const evt = new Event('shopify:cart:lines-update', { bubbles: true });
          evt.promise = Promise.resolve({ cart: { totalQuantity: cart.item_count }, detail: { itemCount: cart.item_count } });
          document.dispatchEvent(evt);
          btn.classList.add('done');
          showToast('Added to cart ✓');
          setTimeout(() => btn.classList.remove('done'), 1600);
        } catch (e) {
          showToast('Could not add to cart');
        } finally {
          btn.disabled = false;
        }
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Chic products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved By Thousands" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All Products" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Filter tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Skincare" },
        {
          "type": "text",
          "id": "match",
          "label": "Match (product type or tag)",
          "default": "skin care",
          "info": "Products whose type or tags contain this text are shown"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Chic products",
      "category": "Products",
      "blocks": [
        { "type": "tab", "settings": { "label": "Skincare", "match": "skin care" } },
        { "type": "tab", "settings": { "label": "Haircare", "match": "hair" } },
        { "type": "tab", "settings": { "label": "Bodycare", "match": "body" } },
        { "type": "tab", "settings": { "label": "Gift Sets & Combos", "match": "gift" } }
      ]
    }
  ]
}
{% endschema %}
