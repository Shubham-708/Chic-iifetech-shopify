{% liquid
  assign s = section.settings
  if s.bg_image != blank
    assign bg_url = s.bg_image | image_url: width: 2000
  else
    assign bg_url = 'chic-story-bg.jpg' | asset_url
  endif
%}

<div class="chic-story">
  <div class="chic-story__frame">
    <img class="chic-story__bg" src="{{ bg_url }}" alt="" loading="lazy" width="1600" height="870" aria-hidden="true">

    <div class="chic-story__txt">
    {% if s.eyebrow != blank %}<p class="chic-story__kick">{{ s.eyebrow | escape }}</p>{% endif %}
    <h2>{{ s.heading | escape }}</h2>
    {% if s.text != blank %}<p class="chic-story__p">{{ s.text }}</p>{% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="chic-story__feats">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            {% render 'chic-icon', icon: block.settings.icon %}
            <span>{{ block.settings.title | escape }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if s.btn_label != blank %}
      <a class="chic-story__btn" href="{{ s.btn_link | default: '/pages/about-us' }}">
        {{ s.btn_label | escape }}
        {% render 'chic-icon', icon: 'arrow' %}
      </a>
    {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .chic-story {
    background: var(--chic-card, #fff);
    padding: clamp(20px, 3vw, 48px) 24px;
  }

  .chic-story__frame {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    border-radius: 22px;
    overflow: hidden;
    background: #eff5ea;
    container-type: inline-size;
  }

  .chic-story__bg {
    display: block;
    width: 100%;
    height: auto;
  }

  .chic-story__txt {
    position: absolute;
    left: 40.5%;
    top: 12%;
    width: 43%;
    color: #1d3a28;
  }

  .chic-story__kick {
    margin: 0 0 0.6cqw;
    font-size: clamp(10px, 1.05cqw, 14px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    color: #1d3a28;
  }

  .chic-story__txt h2 {
    font-family: var(--chic-serif);
    font-weight: 400;
    font-size: clamp(20px, 2.9cqw, 38px);
    line-height: 1.12;
    margin: 0 0 1.2cqw;
    color: #0f3d24;
    white-space: nowrap;
  }

  .chic-story__p {
    font-size: clamp(11px, 1.25cqw, 16px);
    line-height: 1.6;
    margin: 0 0 2cqw;
    color: #1d3a28;
    max-width: 42em;
  }

  .chic-story__feats {
    list-style: none;
    margin: 0 0 2.2cqw;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .chic-story__feats li {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    padding: 0 1.6cqw;
    font-size: clamp(10px, 1.15cqw, 15px);
    line-height: 1.35;
    color: #1d3a28;
    max-width: 200px;
  }

  .chic-story__feats li:first-child { padding-left: 0; }
  .chic-story__feats li + li { border-left: 1px solid #c8d6c0; }

  .chic-story__feats svg {
    width: clamp(24px, 3cqw, 42px);
    height: auto;
    fill: none;
    stroke: #0f3d24;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .chic-story__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #0f4a2a;
    color: #fff;
    border-radius: 4px;
    padding: clamp(9px, 1cqw, 14px) clamp(16px, 2.2cqw, 32px);
    font-size: clamp(12px, 1.15cqw, 15px);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .chic-story__btn:hover {
    background: #0a3a20;
    color: #fff;
    text-decoration: none;
  }

  .chic-story__btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 860px) {
    .chic-story {
      padding: 16px;
    }

    .chic-story__frame {
      display: flex;
      flex-direction: column-reverse;
      border-radius: 18px;
    }

    .chic-story__bg {
      width: 185%;
      max-width: none;
      margin-left: -6%;
    }

    .chic-story__txt {
      position: static;
      width: auto;
      padding: 36px 22px 10px;
    }

    .chic-story__kick { margin-bottom: 10px; }
    .chic-story__txt h2 { margin-bottom: 14px; white-space: normal; }
    .chic-story__p { margin-bottom: 22px; }

    .chic-story__feats {
      flex-wrap: wrap;
      gap: 14px 0;
      margin-bottom: 26px;
    }

    .chic-story__feats li { gap: 10px; padding: 0 14px; }
    .chic-story__feats svg { width: 34px; }
  }

  @media screen and (max-width: 560px) {
    .chic-story__feats li { flex: 1 1 100%; padding: 0; }
    .chic-story__feats li + li { border-left: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic our story",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background artwork",
      "info": "Full-width artwork (1600x870 works best). Leave empty for the bundled CHIC botanical background."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty, Inspired by Nature" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "At The Botanical Beauty, we believe nature gives us the purest form of care. Our products are crafted with the finest botanical ingredients, without harmful chemicals, so you can feel good about what you put on your skin and hair."
    },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "More About Us" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "drop", "label": "Drop" },
            { "value": "lotus", "label": "Lotus" },
            { "value": "shield", "label": "Shield" },
            { "value": "users", "label": "People" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Natural Ingredients" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Chic our story",
      "category": "Storytelling",
      "blocks": [
        { "type": "feature", "settings": { "icon": "leaf", "title": "Natural Ingredients" } },
        { "type": "feature", "settings": { "icon": "heart", "title": "Healthy Skin & Hair" } },
        { "type": "feature", "settings": { "icon": "lotus", "title": "A Greener Tomorrow" } }
      ]
    }
  ]
}
{% endschema %}
