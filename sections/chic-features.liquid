{% comment %} Feature strip that overlaps the section above it (like the hero). {% endcomment %}
<div class="chic-features">
  <div class="chic-wrap">
    <div class="chic-features__box">
      {% for block in section.blocks %}
        <div class="chic-features__item" {{ block.shopify_attributes }}>
          <span class="chic-ic">{% render 'chic-icon', icon: block.settings.icon %}</span>
          <div>
            <h4>{{ block.settings.title | escape }}</h4>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text | escape }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .chic-features {
    position: relative;
    margin-top: -34px;
    z-index: 2;
  }

  .chic-features__box {
    background: var(--chic-card);
    border-radius: 14px;
    box-shadow: 0 12px 40px rgb(13 74 112 / 0.1);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 24px 20px;
  }

  .chic-features__item {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 0 16px;
  }

  .chic-features__item + .chic-features__item {
    border-left: 1px solid var(--chic-line);
  }

  .chic-features__item h4 {
    margin: 0;
    font-family: var(--chic-serif);
    font-weight: 400;
    font-size: 14px;
    color: var(--chic-ink);
  }

  .chic-features__item p {
    margin: 2px 0 0;
    font-size: 12px;
    color: var(--chic-muted);
    line-height: 1.4;
  }

  @media screen and (max-width: 860px) {
    .chic-features__box {
      grid-template-columns: 1fr 1fr;
      gap: 18px 0;
    }

    .chic-features__item:nth-child(odd) { border-left: 0; }
  }

  @media screen and (max-width: 560px) {
    .chic-features__box { grid-template-columns: 1fr; }
    .chic-features__item + .chic-features__item { border-left: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic features strip",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "rabbit", "label": "Rabbit" },
            { "value": "lotus", "label": "Lotus" },
            { "value": "flag", "label": "Flag" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Botanical" },
        { "type": "text", "id": "text", "label": "Text", "default": "Pure, plant-based ingredients" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Chic features strip",
      "category": "Storytelling",
      "blocks": [
        { "type": "feature", "settings": { "icon": "leaf", "title": "100% Botanical", "text": "Pure, plant-based ingredients" } },
        { "type": "feature", "settings": { "icon": "rabbit", "title": "Cruelty Free", "text": "Never tested on animals" } },
        { "type": "feature", "settings": { "icon": "lotus", "title": "Ayurveda Wisdom", "text": "Ancient recipes, modern care" } },
        { "type": "feature", "settings": { "icon": "flag", "title": "Made in India", "text": "Handcrafted in Bhopal, MP" } }
      ]
    }
  ]
}
{% endschema %}
