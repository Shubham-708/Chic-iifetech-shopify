{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div class="section{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">

  <!-- Magazine Grid -->
  <div class="bp-magazine">

    <div class="bp-magazine__image">
      {% if article.image %}
        {{ article.image | image_url: width: 800 | image_tag:
          loading: 'eager',
          widths: '400, 600, 800',
          class: 'bp-magazine__img'
        }}
      {% endif %}
    </div>

    <div class="bp-magazine__intro">
      <p class="bp-magazine__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <h1 class="bp-magazine__title">{{ article.title }}</h1>
      <div class="bp-magazine__excerpt">
        {{ article.excerpt_or_content | strip_html | truncate: 200 }}
      </div>
      {% if article.tags.size > 0 %}
        <ul class="bp-magazine__keypoints">
          {% for tag in article.tags limit: 5 %}
            <li>✦ {{ tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="bp-magazine__body">
      {{ article.content }}
    </div>

  </div>

  {% if blog.comments_enabled? %}
    <div class="blog-post-comments-container">
      <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>
      <div class="blog-post-comments">
        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}
            <div class="blog-post-comment">
              {{ comment.content }}
              <div class="blog-post-comment__author">
                <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                <span class="blog-post-comment__date">{{- comment.created_at | time_tag: format: 'date' -}}</span>
              </div>
            </div>
          {% endfor %}
          <div class="blog-post-comments-pagination">{{- paginate | default_pagination -}}</div>
        {% endpaginate %}
      </div>
      {% render 'blog-comment-form', article: article, section_id: section.id %}
    </div>
  {% endif %}

  <!-- Related Posts -->
  <div class="blog-post-related">
    <div class="blog-post-related__header">
      <h2 class="blog-post-related__heading">More from the Journal</h2>
      <div class="chic-carousel-arrows">
        <button class="chic-arrow bpr-prev" aria-label="Previous">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="chic-arrow bpr-next" aria-label="Next">
          <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
        </button>
      </div>
    </div>

    <div class="blog-post-related__wrapper">
      <div class="blog-post-related__grid">
        {% assign count = 0 %}
        {% for related in blog.articles %}
          {% if related.id != article.id and count < 5 %}
            {% assign count = count | plus: 1 %}
            <a href="{{ related.url }}" class="blog-post-related__card">
              {% if related.image %}
                {{ related.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'blog-post-related__img' }}
              {% endif %}
              <div class="blog-post-related__card-content">
                <p class="blog-post-related__card-date">{{ related.published_at | date: '%B %d, %Y' }}</p>
                <h3 class="blog-post-related__card-title">{{ related.title }}</h3>
                <span class="blog-post-related__read-more">Read more →</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

</div>

<script>
  (function() {
    const grid = document.querySelector('.blog-post-related__grid');
    const prevBtn = document.querySelector('.bpr-prev');
    const nextBtn = document.querySelector('.bpr-next');
    if (!grid || !prevBtn || !nextBtn) return;

    const scrollAmount = () => {
      const card = grid.querySelector('.blog-post-related__card');
      return card ? card.offsetWidth + 14 : 200;
    };

    prevBtn.addEventListener('click', () => {
      grid.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      grid.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  })();
</script>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}

  /* ── Related Posts ── */
  .blog-post-related {
    background: #faf8f5;
    padding: 60px 40px;
    margin-top: 60px;
  }

  .blog-post-related__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .blog-post-related__heading {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0;
  }

  .chic-carousel-arrows {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .chic-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--chic-line, #ddd);
    background: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    flex: none;
  }

  .chic-arrow:hover {
    background: var(--chic-navy, #1a2e44);
    border-color: var(--chic-navy, #1a2e44);
  }

  .chic-arrow svg {
    width: 16px;
    height: 16px;
    stroke: var(--chic-navy, #1a2e44);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.2s ease;
  }

  .chic-arrow:hover svg { stroke: #fff; }

  .blog-post-related__wrapper { overflow: hidden; }

  .blog-post-related__grid {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .blog-post-related__grid::-webkit-scrollbar { display: none; }

  .blog-post-related__card {
    text-decoration: none;
    color: inherit;
    flex: 0 0 calc(20% - 12px);
    min-width: 160px;
    scroll-snap-align: start;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.2s ease;
    display: block;
  }

  .blog-post-related__card:hover { transform: translateY(-4px); }

  .blog-post-related__img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .blog-post-related__card-content { padding: 10px; }

  .blog-post-related__card-date {
    font-size: 10px;
    color: rgb(var(--color-foreground-rgb) / 0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .blog-post-related__card-title {
    font-size: 12.5px;
    font-weight: 600;
    margin-bottom: 6px;
    line-height: 1.4;
    color: var(--color-foreground);
  }

  .blog-post-related__read-more {
    font-size: 11px;
    font-weight: 600;
    text-decoration: underline;
  }

  /* ── Magazine Grid ── */
  .bp-magazine {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto 60px;
    padding: 40px;
  }

  .bp-magazine__image { grid-column: 1; grid-row: 1; }

  .bp-magazine__img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center top;
    display: block;
    border-radius: 12px;
  }

  .bp-magazine__intro {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8px 0;
  }

  .bp-magazine__date {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(var(--color-foreground-rgb) / 0.5);
    margin-bottom: 12px;
  }

  .bp-magazine__title {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 16px;
    color: var(--color-foreground);
  }

  .bp-magazine__excerpt {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 0.75);
    margin-bottom: 20px;
  }

  .bp-magazine__keypoints {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bp-magazine__keypoints li {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-foreground);
    padding: 8px 12px;
    background: #f5f0ea;
    border-radius: 8px;
  }

  .bp-magazine__body {
    grid-column: 1 / -1;
    grid-row: 2;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-foreground);
    column-count: 2;
    column-gap: 48px;
  }

  .bp-magazine__body img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border-radius: 8px;
    column-span: all;
    margin-bottom: 16px;
  }

  /* ── Comments ── */
  .blog-post-comments-container {
    max-width: 860px;
    margin: 0 auto 60px;
    padding: 0 40px;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a { color: var(--color-foreground); }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }

  /* ── Tablet ── */
  @media screen and (max-width: 1024px) {
    .bp-magazine { padding: 32px 24px; gap: 24px; }
    .bp-magazine__title { font-size: 1.5rem; }
    .bp-magazine__body { column-count: 1; }
    .blog-post-related__card { flex: 0 0 calc(33.33% - 10px); }
    .blog-post-related { padding: 40px 24px; }
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .bp-magazine {
      grid-template-columns: 1fr;
      padding: 20px 16px;
      gap: 20px;
    }

    .bp-magazine__image { grid-column: 1; grid-row: 1; }
    .bp-magazine__intro { grid-column: 1; grid-row: 2; }
    .bp-magazine__body  { grid-column: 1; grid-row: 3; column-count: 1; }
    .bp-magazine__title { font-size: 1.4rem; }

    .blog-post-related { padding: 40px 16px; }
    .blog-post-related__card {
      flex: 0 0 calc(33.33% - 10px);
      min-width: 120px;
    }

    .blog-post-comments-container { padding: 0 16px; }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "_blog-post-title" },
    { "type": "_blog-post-info-text" },
    { "type": "_blog-post-featured-image" },
    { "type": "_blog-post-content" }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
