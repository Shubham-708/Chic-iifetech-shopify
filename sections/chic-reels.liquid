{% liquid
  assign s = section.settings
  assign insta_url = s.instagram_url | default: 'https://www.instagram.com/'
%}

<div class="chic-section chic-reels" id="chic-reels-{{ section.id }}" data-chic-reels>
  <div class="chic-wrap">
    <div class="chic-reels__head">
      <div class="chic-reels__title">
        {% if s.eyebrow != blank %}
          <a class="chic-reels__handle" href="{{ insta_url }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" class="dot"/></svg>
            {{ s.eyebrow | escape }}
          </a>
        {% endif %}
        <h2>{{ s.heading | escape }}</h2>
        {% if s.subheading != blank %}<p class="chic-reels__sub">{{ s.subheading | escape }}</p>{% endif %}
      </div>
      <div class="chic-reels__nav">
        <button type="button" class="chic-reels__arrow" data-chic-reels-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="chic-reels__arrow" data-chic-reels-next aria-label="Next">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="chic-reels__row" data-chic-reels-track>
      {% for block in section.blocks %}
        {% liquid
          assign bs = block.settings
          assign reel_url = bs.reel_url | strip
          assign p = bs.product
          assign tile_link = insta_url
          if reel_url != blank
            assign tile_link = reel_url
          endif
        %}
        <div class="chic-reels__card" {{ block.shopify_attributes }}>
          {% if reel_url != blank and bs.video == blank and bs.image == blank and bs.fallback_asset == blank %}
            {% liquid
              assign embed_url = reel_url | split: '?' | first
              unless embed_url contains 'instagram.com'
                assign embed_url = blank
              endunless
              if embed_url != blank
                assign last_char = embed_url | slice: -1
                unless last_char == '/'
                  assign embed_url = embed_url | append: '/'
                endunless
                assign embed_url = embed_url | append: 'embed'
              endif
            %}
            {% if embed_url != blank %}
              <iframe src="{{ embed_url }}" loading="lazy" allowfullscreen allow="autoplay; encrypted-media" title="Instagram reel" scrolling="no"></iframe>
            {% endif %}
          {% else %}
            <a class="chic-reels__media" href="{{ tile_link }}" target="_blank" rel="noopener" aria-label="Watch on Instagram">
              {% if bs.video != blank %}
                {{ bs.video | video_tag: loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
              {% elsif bs.image != blank %}
                {{ bs.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 990px) 280px, 62vw', alt: s.heading }}
              {% elsif bs.fallback_asset != blank %}
                <img src="{{ bs.fallback_asset | asset_url }}" alt="{{ s.heading | escape }}" loading="lazy" width="540" height="960">
              {% endif %}
              <span class="chic-reels__shade" aria-hidden="true"></span>
              <span class="chic-reels__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" class="dot"/></svg>
              </span>
              <span class="chic-reels__play" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M9 6.5v11l9-5.5-9-5.5Z"/></svg>
              </span>
            </a>
          {% endif %}

          {% if p != blank %}
            <a class="chic-reels__product" href="{{ p.url }}">
              {% if p.featured_image %}
                {{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: p.title, width: 46, height: 46 }}
              {% endif %}
              <span class="chic-reels__pinfo">
                <span class="chic-reels__pname">{{ p.title | escape }}</span>
                <span class="chic-reels__pprice">
                  {{ p.price | money }}
                  {%- if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif -%}
                </span>
              </span>
              <span class="chic-reels__pgo" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
              </span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if s.link_label != blank %}
      <div class="chic-reels__cta">
        <a class="chic-btn chic-btn--solid" href="{{ insta_url }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" class="dot"/></svg>
          {{ s.link_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .chic-reels {
    background: linear-gradient(180deg, #fff 0%, var(--chic-mint-xl) 100%);
  }

  .chic-reels__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .chic-reels__handle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--chic-green);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .chic-reels svg rect,
  .chic-reels svg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .chic-reels svg circle.dot { fill: currentColor; stroke: none; }

  .chic-reels__handle svg { width: 18px; height: 18px; }

  .chic-reels__title h2 {
    margin: 0;
    font-family: var(--chic-sans);
    font-weight: 600;
    font-size: clamp(24px, 2.8vw, 36px);
    letter-spacing: -0.01em;
    color: var(--chic-ink);
  }

  .chic-reels__sub {
    margin: 8px 0 0;
    color: var(--chic-muted);
    font-size: 14px;
  }

  .chic-reels__nav { display: flex; gap: 10px; }

  .chic-reels__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--chic-line);
    border-radius: 50%;
    background: #fff;
    color: var(--chic-ink);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .chic-reels__arrow:hover { background: var(--chic-navy); border-color: var(--chic-navy); color: #fff; }
  .chic-reels__arrow[disabled] { opacity: 0.35; pointer-events: none; }

  .chic-reels__arrow svg,
  .chic-reels__pgo svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chic-reels__row {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 4px 2px 18px;
    scrollbar-width: none;
  }

  .chic-reels__row::-webkit-scrollbar { display: none; }

  .chic-reels__card {
    position: relative;
    flex: 0 0 calc((100% - 4 * 18px) / 5);
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    background: var(--chic-mint);
    box-shadow: 0 10px 30px rgb(13 74 112 / 0.1);
    scroll-snap-align: start;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .chic-reels__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgb(13 74 112 / 0.18);
  }

  .chic-reels__card iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .chic-reels__media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .chic-reels__media video,
  .chic-reels__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .chic-reels__card:hover .chic-reels__media video,
  .chic-reels__card:hover .chic-reels__media img { transform: scale(1.05); }

  .chic-reels__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.18) 0%, transparent 22%, transparent 55%, rgb(0 0 0 / 0.45) 100%);
    pointer-events: none;
  }

  .chic-reels__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.22);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
  }

  .chic-reels__badge svg { width: 18px; height: 18px; }

  .chic-reels__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin: -29px 0 0 -29px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    opacity: 0.9;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .chic-reels__play svg { width: 26px; height: 26px; fill: currentColor; margin-left: 3px; }
  .chic-reels__card:hover .chic-reels__play { transform: scale(1.1); opacity: 1; }
  .chic-reels__card.is-playing .chic-reels__play { opacity: 0; }

  .chic-reels__product {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px 8px 8px;
    border-radius: 14px;
    background: rgb(20 24 22 / 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  .chic-reels__product:hover { background: rgb(20 24 22 / 0.65); color: #fff; text-decoration: none; }

  .chic-reels__product img {
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    object-fit: contain;
    border-radius: 9px;
    background: #fff;
  }

  .chic-reels__pinfo { min-width: 0; flex: 1; display: grid; gap: 2px; }

  .chic-reels__pname {
    overflow: hidden;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .chic-reels__pprice { font-size: 13px; font-weight: 600; }
  .chic-reels__pprice s { margin-left: 4px; font-weight: 400; opacity: 0.65; }

  .chic-reels__pgo {
    flex: 0 0 28px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    color: var(--chic-ink);
  }

  .chic-reels__pgo svg { width: 14px; height: 14px; }

  .chic-reels__cta {
    display: flex;
    justify-content: center;
    margin-top: 18px;
  }

  .chic-reels__cta .chic-btn { display: inline-flex; align-items: center; gap: 8px; }
  .chic-reels__cta svg { width: 18px; height: 18px; }

  @media screen and (max-width: 1100px) {
    .chic-reels__card { flex-basis: calc((100% - 3 * 16px) / 3.4); }
  }

  @media screen and (max-width: 749px) {
    .chic-reels__nav { display: none; }
    .chic-reels__row { gap: 12px; margin: 0 -16px; padding-inline: 16px; scroll-padding-inline: 16px; }
    .chic-reels__card { flex-basis: 62%; border-radius: 16px; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const init = (root) => {
      if (root.dataset.chicInit) return;
      root.dataset.chicInit = '1';
      const track = root.querySelector('[data-chic-reels-track]');
      const prev = root.querySelector('[data-chic-reels-prev]');
      const next = root.querySelector('[data-chic-reels-next]');
      if (track) {
        const step = () => track.clientWidth * 0.8;
        const update = () => {
          if (prev) prev.disabled = track.scrollLeft <= 2;
          if (next) next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
        };
        prev?.addEventListener('click', () => track.scrollBy({ left: -step() }));
        next?.addEventListener('click', () => track.scrollBy({ left: step() }));
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
      const videos = root.querySelectorAll('video');
      if (!videos.length) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const v = entry.target;
          const card = v.closest('.chic-reels__card');
          if (entry.isIntersecting) {
            v.play().then(() => card?.classList.add('is-playing')).catch(() => {});
          } else {
            v.pause();
            card?.classList.remove('is-playing');
          }
        });
      }, { threshold: 0.5 });
      videos.forEach((v) => io.observe(v));
    };
    const boot = () => document.querySelectorAll('[data-chic-reels]').forEach(init);
    boot();
    document.addEventListener('shopify:section:load', boot);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Chic Instagram reels",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Instagram handle", "default": "@chic_the_botanical_beauty" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh From Our Instagram" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real routines, real results — tap a product to shop the look." },
    { "type": "url", "id": "instagram_url", "label": "Instagram profile link" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Follow us on Instagram" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Reel video (recommended)",
          "info": "Upload the reel as a 9:16 video — it autoplays muted, like on Instagram"
        },
        { "type": "image_picker", "id": "image", "label": "Or a cover image" },
        {
          "type": "text",
          "id": "reel_url",
          "label": "Instagram reel link",
          "info": "Tile opens this reel. With no video or image, the live Instagram embed is shown instead."
        },
        { "type": "product", "id": "product", "label": "Tagged product", "info": "Shows a shoppable product tag on the reel" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Chic Instagram reels",
      "category": "Storytelling",
      "blocks": [
        { "type": "reel", "settings": { "fallback_asset": "chic-insta-1.jpg" } },
        { "type": "reel", "settings": { "fallback_asset": "chic-insta-2.jpg" } },
        { "type": "reel", "settings": { "fallback_asset": "chic-insta-3.jpg" } },
        { "type": "reel", "settings": { "fallback_asset": "chic-insta-4.jpg" } },
        { "type": "reel", "settings": { "fallback_asset": "chic-insta-5.jpg" } }
      ]
    }
  ]
}
{% endschema %}
