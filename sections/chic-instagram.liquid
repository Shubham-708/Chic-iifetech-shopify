{% liquid
  assign s = section.settings
  assign insta_url = s.instagram_url | default: 'https://www.instagram.com/'
%}

<div
  class="chic-instagram"
  style="--chic-insta-bg: {{ s.background_color }}; --chic-insta-text: {{ s.text_color }};"
>
  <div class="chic-instagram__inner">
    <div class="chic-instagram__center">
      {% if s.heading != blank %}
        <h2 class="chic-instagram__heading">{{ s.heading | escape }}</h2>
      {% endif %}
      {% if s.handle != blank %}
        <a class="chic-instagram__handle" href="{{ insta_url }}" target="_blank" rel="noopener">{{ s.handle | escape }}</a>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      <a
        class="chic-instagram__item chic-instagram__item--{{ forloop.index }}"
        href="{{ insta_url }}"
        target="_blank"
        rel="noopener"
        aria-label="{{ 'Instagram' }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 640 | image_tag: class: 'chic-instagram__image', alt: s.handle }}
        {% elsif block.settings.default_asset != blank %}
          <img
            src="{{ block.settings.default_asset | asset_url }}"
            class="chic-instagram__image"
            alt="{{ s.handle | escape }}"
            loading="lazy"
            width="640"
            height="640"
          >
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .chic-instagram {
    background-color: var(--chic-insta-bg);
    color: var(--chic-insta-text);
    overflow: hidden;
  }

  .chic-instagram__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) clamp(16px, 4vw, 48px);
  }

  .chic-instagram__center {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    padding: 12px 0 20px;
  }

  .chic-instagram__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.8rem, 4.5vw, 3.2rem);
    line-height: 1.15;
    max-width: 14ch;
  }

  .chic-instagram__handle {
    font-family: var(--font-heading--family);
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    color: inherit;
    text-decoration: none;
    opacity: 0.85;
  }

  .chic-instagram__handle:hover {
    text-decoration: underline;
  }

  .chic-instagram__item {
    display: block;
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgb(20 28 18 / 0.12);
  }

  .chic-instagram__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .chic-instagram__item:hover .chic-instagram__image {
    transform: scale(1.06);
  }

  /* Desktop: scattered collage around centered heading */
  @media screen and (min-width: 900px) {
    .chic-instagram__inner {
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: auto auto;
      align-items: center;
      gap: clamp(20px, 3vw, 44px);
    }

    .chic-instagram__center {
      grid-column: 3 / 5;
      grid-row: 1 / 3;
      padding: 0;
    }

    .chic-instagram__item { max-width: 230px; }

    .chic-instagram__item--1 { grid-column: 1; grid-row: 1; transform: translateY(-14px); }
    .chic-instagram__item--2 { grid-column: 2; grid-row: 1; transform: translateY(26px); }
    .chic-instagram__item--3 { grid-column: 5; grid-row: 1; transform: translateY(-20px); }
    .chic-instagram__item--4 { grid-column: 6; grid-row: 1; transform: translateY(18px); }
    .chic-instagram__item--5 { grid-column: 2; grid-row: 2; transform: translateY(10px); }
    .chic-instagram__item--6 { grid-column: 5; grid-row: 2; transform: translateY(30px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic Instagram",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Checkout Us On Instagram"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@chic_the_botanical_beauty"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBF9F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2F3A2F"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Fallback asset filename"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Chic Instagram",
      "category": "Storytelling",
      "blocks": [
        { "type": "post", "settings": { "default_asset": "chic-insta-1.jpg" } },
        { "type": "post", "settings": { "default_asset": "chic-insta-2.jpg" } },
        { "type": "post", "settings": { "default_asset": "chic-insta-3.jpg" } },
        { "type": "post", "settings": { "default_asset": "chic-insta-4.jpg" } },
        { "type": "post", "settings": { "default_asset": "chic-insta-5.jpg" } },
        { "type": "post", "settings": { "default_asset": "chic-insta-6.jpg" } }
      ]
    }
  ]
}
{% endschema %}
