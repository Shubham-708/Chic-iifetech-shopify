<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    <div
      ref="grid"
      class="blog-posts-container"
    >
      {% liquid
        assign image_index = 0
        assign eager_image_count = 2
        assign image_sizes = '(min-width: 1520px) 456px, (min-width: 750px) calc(33.33vw - 51px), calc(100vw - 32px)'
      %}
      {% for article in blog.articles %}
        {% liquid
          assign image_loading = 'lazy'
          assign image_fetch_priority = 'auto'
          if article.image
            assign image_index = image_index | plus: 1
            if image_index <= eager_image_count
              assign image_loading = 'eager'
            endif
            if image_index == 1
              assign image_fetch_priority = 'high'
            endif
          endif
        %}
        <div
          class="blog-post-item"
          data-testid="blog-post-item"
        >
          {% content_for 'block',
            id: 'static-blog-post-card',
            type: '_blog-post-card',
            article: article,
            image_sizes: image_sizes,
            image_loading: image_loading,
            image_fetch_priority: image_fetch_priority,
            is_horizontal: false
          %}
        </div>
      {% endfor %}
    </div>
  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 14px;
    --rows-gap: 14px;
  }

  /* ── Desktop: 5 columns ── */
  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--rows-gap) var(--columns-gap);
    width: 100%;
  }

  .blog-post-item {
    grid-column: span 1;
    background-color: var(--color-background);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  /* ── Square image 1:1 ── */
  .blog-post-card__image-container img,
  .blog-post-card__image-container .placeholder-svg {
    aspect-ratio: 1 / 1 !important;
    object-fit: cover !important;
    object-position: center top !important;
    width: 100% !important;
    height: auto !important;
    display: block;
  }

  /* ── Tablet: 3 columns ── */
  @media screen and (max-width: 1024px) and (min-width: 750px) {
    .blog-posts-container {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Mobile: 3 columns ── */
  @media screen and (max-width: 749px) {
    .blog-posts-container {
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .blog-post-item {
      grid-column: span 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "text" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "button" },
    { "type": "video" },
    { "type": "group" },
    { "type": "spacer" },
    { "type": "_divider" }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
