{% liquid
  assign s = section.settings
  assign blog = s.blog | default: blogs['news']
%}
{%- if blog.articles_count > 0 or request.design_mode -%}

<div class="chic-section">
  <div class="chic-wrap">
    <div class="chic-sec-head">
      <div>
        {% if s.eyebrow != blank %}<p class="chic-eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
        <h2>{{ s.heading | escape }}</h2>
      </div>
      <div class="chic-journal-controls">
        {% if blog != blank and s.link_label != blank %}
          <a class="chic-more" href="{{ blog.url }}">{{ s.link_label | escape }} →</a>
        {% endif %}
        <div class="chic-carousel-arrows">
          <button class="chic-arrow chic-journal-prev" aria-label="Previous">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="chic-arrow chic-journal-next" aria-label="Next">
            <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="chic-blogs-wrapper">
      <div class="chic-blogs">
        {% if blog != blank and blog.articles_count > 0 %}
          {% for article in blog.articles limit: 6 %}
            <a class="chic-blog" href="{{ article.url }}">
              {% if article.image %}
                {{ article.image | image_url: width: 480 | image_tag: loading: 'lazy', alt: article.title }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'chic-blog__placeholder' }}
              {% endif %}
              <div>
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
                <h4>{{ article.title | escape }}</h4>
                <span class="chic-blog__rm">Read More</span>
              </div>
            </a>
          {% endfor %}
        {% else %}
          {% assign placeholders = 'Why Nature Is Not a Luxury, But a Necessity|The Champi Ritual: Herbal Hair Oiling, Done Right|Morning vs. Night: Building Your Skin Ritual' | split: '|' %}
          {% for title in placeholders %}
            <div class="chic-blog">
              <img src="{{ 'chic-insta-' | append: forloop.index | append: '.jpg' | asset_url }}" alt="" loading="lazy" width="480" height="480">
              <div>
                <time>{{ 'now' | date: '%B %d, %Y' }}</time>
                <h4>{{ title }}</h4>
                <span class="chic-blog__rm">Read More</span>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    const grid = document.querySelector('.chic-blogs');
    const prevBtn = document.querySelector('.chic-journal-prev');
    const nextBtn = document.querySelector('.chic-journal-next');
    if (!grid || !prevBtn || !nextBtn) return;

    const scrollAmount = () => {
      const card = grid.querySelector('.chic-blog');
      return card ? card.offsetWidth + 18 : 340;
    };

    prevBtn.addEventListener('click', () => {
      grid.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      grid.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  })();
</script>

{%- endif -%}

{% stylesheet %}
  /* Controls row */
  .chic-journal-controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .chic-carousel-arrows {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .chic-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--chic-line);
    background: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    flex: none;
  }

  .chic-arrow:hover {
    background: var(--chic-navy);
    border-color: var(--chic-navy);
  }

  .chic-arrow svg {
    width: 18px;
    height: 18px;
    stroke: var(--chic-navy);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.2s ease;
  }

  .chic-arrow:hover svg { stroke: #fff; }

  /* Blogs wrapper */
  .chic-blogs-wrapper {
    overflow: hidden;
  }

  .chic-blogs {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .chic-blogs::-webkit-scrollbar { display: none; }

  .chic-blog {
    display: grid;
    grid-template-columns: 48% 1fr;
    background: var(--chic-card);
    border: 1px solid var(--chic-line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    flex: 0 0 calc(33.33% - 12px);
    scroll-snap-align: start;
    min-width: 280px;
  }

  .chic-blog:hover { text-decoration: none; }
  .chic-blog:hover h4 { color: var(--chic-navy); }

  .chic-blog img,
  .chic-blog__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 150px;
  }

  .chic-blog > div { padding: 16px; }

  .chic-blog time {
    font-size: 11px;
    color: var(--chic-muted);
  }

  .chic-blog h4 {
    font-family: var(--chic-serif);
    font-weight: 400;
    font-size: 14.5px;
    line-height: 1.45;
    margin: 6px 0 10px;
    color: var(--chic-ink);
  }

  .chic-blog__rm {
    font-size: 12px;
    color: var(--chic-navy);
    font-weight: 500;
  }

  @media screen and (max-width: 860px) {
    .chic-blog { flex: 0 0 80%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chic journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tips, Rituals & Insights" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All Posts" }
  ],
  "presets": [
    {
      "name": "Chic journal",
      "category": "Blog"
    }
  ]
}
{% endschema %}
